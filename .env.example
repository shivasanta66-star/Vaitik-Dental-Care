# Copy to .env.local for local development. On Netlify, add these under
# Site configuration → Environment variables. Never commit real values.

# Supabase → Project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Full database access: never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# New-booking emails (resend.com). CLINIC_EMAIL can list several addresses, comma-separated.
RESEND_API_KEY=
CLINIC_EMAIL=
# Must be an address on a domain you verified in Resend. Defaults to Resend's test sender.
RESEND_FROM=Vaitik Dental Care <bookings@your-domain.in>

# Razorpay (optional booking fee; also switch it on in Admin → Settings). Use test keys first.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional: secret used to hash IP addresses for rate limiting (defaults to the service role key).
RATE_LIMIT_SALT=
